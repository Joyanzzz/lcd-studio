{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos mínimos de la ventana principal: título, cierre controlado y los comandos propios de archivos.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "allow-open-project",
    "allow-accept-opened-project",
    "allow-save-project",
    "allow-save-export",
    "allow-forget-project-file"
  ]
}
