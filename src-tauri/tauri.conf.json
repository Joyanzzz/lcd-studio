{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LCD Studio",
  "version": "1.0.0",
  "identifier": "com.lcdstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' blob:",
        "font-src": "'self'",
        "worker-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LCD Studio",
    "copyright": "Copyright (c) 2026 LCD Studio contributors. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "Editor de gráficos y animaciones para pantallas LCD y OLED",
    "longDescription": "Diseña gráficos y animaciones para LCD de caracteres HD44780, pantallas gráficas y OLED, y exporta código y datos. Todo se procesa localmente.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
