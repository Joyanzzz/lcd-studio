{
  "name": "lcd-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Editor local de gráficos y animaciones para pantallas LCD de caracteres, gráficas y OLED.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --strictPort --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icons": "node scripts/generate-icons.ts",
    "audit:deps": "npm audit --omit=dev && node scripts/check-licenses.ts",
    "arduino:check": "node scripts/arduino-check.ts",
    "bench": "node scripts/benchmark.ts",
    "bench:browser": "node scripts/measure-browser.ts",
    "notices": "node scripts/third-party-notices.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "fflate": "0.8.3",
    "omggif": "1.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "24.19.2",
    "@types/omggif": "1.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
